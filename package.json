{
  "name": "bluearchive-heardle",
  "version": "1.0.0",
  "private": false,
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@esotericsoftware/spine-webgl": "4.2.120",
    "@fontsource-variable/nunito-sans": "^5.2.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0",
    "styled-components": "^6.5.3"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "wrangler dev --config site-worker/wrangler.jsonc --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:audio": "node scripts/check-audio.mjs",
    "check:pictures": "node scripts/check-pictures.mjs",
    "build:audio": "node scripts/build-audio.mjs && prettier --write src/constants/audioClips.ts",
    "build:pictures": "node scripts/build-pictures.mjs && prettier --write src/constants/pictureFiles.ts src/constants/portraitFiles.ts",
    "seasons": "node scripts/make-seasons.mjs && npm run build:pictures",
    "upload:audio": "wrangler deploy --config audio-worker/wrangler.jsonc",
    "deploy:site": "wrangler deploy --config site-worker/wrangler.jsonc",
    "deploy:site-preview": "tsc --noEmit && vite build --mode preview && wrangler deploy --config site-worker/wrangler.preview.jsonc",
    "rooms": "wrangler dev --config rooms-worker/wrangler.jsonc --port 8787 --var ROOM_PASS_KEY:local-only-not-a-secret",
    "deploy:rooms": "wrangler deploy --config rooms-worker/wrangler.jsonc",
    "accounts": "wrangler d1 migrations apply ba-heardle-accounts --local --config accounts-worker/wrangler.jsonc && wrangler dev --config accounts-worker/wrangler.jsonc --port 8788 --var STATE_KEY:local-only-not-a-secret --var ROOM_PASS_KEY:local-only-not-a-secret --var FAKE_SIGN_IN:yes",
    "accounts:measure": "wrangler d1 migrations apply ba-heardle-accounts --local --config accounts-worker/wrangler.jsonc && wrangler dev --config accounts-worker/wrangler.jsonc --port 8788 --var STATE_KEY:local-only-not-a-secret --var ROOM_PASS_KEY:local-only-not-a-secret --var FAKE_SIGN_IN:yes --var MEASURE:yes",
    "build:global-now": "node scripts/build-global-now.mjs",
    "find-updates": "node scripts/find-updates.mjs",
    "build:new-songs": "node scripts/build-new-songs.mjs && prettier --write src/constants/songs.ts",
    "global-now": "node scripts/build-global-now.mjs && wrangler deploy --config now-worker/wrangler.jsonc",
    "upload:backup": "node scripts/upload-backup.mjs",
    "build:daily-order": "node scripts/build-daily-order.mjs && prettier --write src/constants/dailyOrder.ts",
    "build:students": "node scripts/build-students.mjs && prettier --write src/constants/students.ts src/constants/studentDailyOrder.ts src/constants/clueIcons.ts",
    "build:voices": "node scripts/build-voices.mjs && npm run build:voice-tones && prettier --write src/constants/silhouettes.ts src/constants/voiceDailyOrder.ts",
    "build:guess": "node scripts/build-guess-pictures.mjs && prettier --write src/constants/guessPictures.ts src/constants/guessDailyOrder.ts",
    "build:voice-tones": "node scripts/build-voice-tones.mjs && prettier --write src/constants/voiceTones.ts",
    "build:voice-audio": "node scripts/build-voice-audio.mjs && prettier --write src/constants/voiceLines.ts",
    "songs": "npm run build:daily-order && npm run build:audio && npm run build:voice-audio && npm run build:pictures && npm run upload:audio && npm run upload:backup && node scripts/check-audio.mjs --remote && node scripts/check-pictures.mjs --remote",
    "students": "npm run build:students && npm run build:voices && npm run build:guess && npm run songs",
    "voices": "npm run build:voices && npm run songs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p rooms-worker && tsc --noEmit -p accounts-worker",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings 0",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"rooms-worker/*.ts\" \"accounts-worker/*.ts\" \"*.{json,js,cjs,md,html}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"rooms-worker/*.ts\" \"accounts-worker/*.ts\" \"*.{json,js,cjs,md,html}\"",
    "prepare": "husky install",
    "check:pages": "node scripts/check-pages.mjs",
    "download:music": "node scripts/download-music.mjs"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260929.1",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.39.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "husky": "^7.0.4",
    "jsdom": "^25.0.1",
    "prettier": "^2.6.0",
    "puppeteer-core": "^23.11.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.1",
    "wrangler": "4.143.1"
  },
  "engines": {
    "node": ">=20"
  }
}
