# Headers for the site on Cloudflare (site-worker/). Not served itself.
# A path matching several rules gets all their headers. Lines are capped at
# 2,000 characters and the file at 100 rules.
#
# The Content-Security-Policy lets the page load only from itself, the audio
# Worker, the R2 backup and the Now Worker, and connect to the rooms Worker
# for multiplayer: a new outside address must be added here, or it's blocked.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://ba-heardle-audio.shinrunner1st.workers.dev https://audio.baheardle.com https://ba-heardle-now.shinrunner1st.workers.dev; media-src 'self' blob: https://ba-heardle-audio.shinrunner1st.workers.dev https://audio.baheardle.com; connect-src 'self' blob: https://ba-heardle-audio.shinrunner1st.workers.dev https://audio.baheardle.com https://ba-heardle-now.shinrunner1st.workers.dev wss://ba-heardle-rooms.shinrunner1st.workers.dev; font-src 'self' data:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()
  Strict-Transport-Security: max-age=63072000

# Built files carry a hash in their name, so they never change.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Files that keep their name: a week, then used while checked in the background.
/favicon.ico
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
/logo192.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
/logo512.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
/apple-touch-icon.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
/preview.jpg
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
/previews/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
/spine/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
/cursor/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

# The test address and the preview: baheardle.com is the one to index.
https://ba-heardle-site.shinrunner1st.workers.dev/*
  X-Robots-Tag: noindex
https://ba-heardle-site-preview.shinrunner1st.workers.dev/*
  X-Robots-Tag: noindex
