// Multiplayer rooms: the only Worker here that runs code. Each room is a
// Durable Object (GameRoom in index.ts), reached over a WebSocket at
// /room/<code>. The free plan's SQLite-backed objects, within its daily
// limits (see the README's Multiplayer). CI publishes it from `main` with
// the site, so the two agree on the songs and the messages; `npm run
// deploy:rooms` does it by hand, and `npm run rooms` runs it locally.
{
  "name": "ba-heardle-rooms",
  "main": "index.ts",
  "compatibility_date": "2026-09-01",
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "GameRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }],
  // Counted per address (hashed) a minute, before a room wakes: a few rooms
  // made, and enough connections for a table of friends behind one router
  // coming and going. Past either, the page is asked to wait a minute.
  "ratelimits": [
    {
      "name": "MAKE_LIMIT",
      "namespace_id": "1701",
      "simple": { "limit": 6, "period": 60 }
    },
    {
      "name": "JOIN_LIMIT",
      "namespace_id": "1702",
      "simple": { "limit": 40, "period": 60 }
    }
  ],
  // No logs or traces are kept: nothing of a room outlives it.
  "observability": { "enabled": false },
  "workers_dev": true,
  "preview_urls": false
}
