# Where production builds load the audio from: the Cloudflare Worker in
# audio-worker/, filled by `npm run songs`. Not a secret.
VITE_AUDIO_BASE_URL=https://ba-heardle-audio.shinrunner1st.workers.dev
# The copy on Cloudflare R2 (bucket ba-heardle-audio), for when the Worker
# fails. Also filled by `npm run songs`.
VITE_AUDIO_BACKUP_URL=https://audio.baheardle.com
# What is on in Blue Archive Global now, for the hub: the Worker in
# now-worker/, filled by `npm run global-now` and a GitHub Action.
VITE_NOW_URL=https://ba-heardle-now.shinrunner1st.workers.dev
# Multiplayer rooms: the Worker in rooms-worker/, published from main by CI
# and by `npm run deploy:rooms`.
VITE_ROOMS_URL=wss://ba-heardle-rooms.shinrunner1st.workers.dev
